{
  "name": "@posguru/finance-core",
  "version": "1.0.0-alpha5",
  "description": "Universal JavaScript library for finance-related math functions, usable in both Node.js (Express) and React applications.",
  "type": "module",
  "main": "./dist/sdk.umd.cjs",
  "module": "./dist/sdk.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/sdk.js",
      "require": "./dist/sdk.umd.cjs"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && vite build"
  },
  "keywords": [
    "finance",
    "math",
    "universal",
    "react",
    "nodejs",
    "express",
    "posguru"
  ],
  "devDependencies": {
    "typescript": "^5.6.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.8.0",
    "rimraf": "^5.0.0"
  }
}
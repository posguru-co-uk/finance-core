{
  "name": "@posguru/finance-core",
  "version": "3.0.1",
  "description": "Universal JavaScript library for finance-related math functions, usable in both Node.js (Express) and React applications.",
  "type": "module",
  "main": "./dist/sdk.cjs",
  "module": "./dist/sdk.esm.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/sdk.cjs",
      "import": "./dist/sdk.esm.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && vite build"
  },
  "keywords": [
    "finance",
    "math",
    "universal",
    "react",
    "nodejs",
    "express",
    "posguru"
  ],
  "devDependencies": {
    "rimraf": "^5.0.10",
    "typescript": "^5.6.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
